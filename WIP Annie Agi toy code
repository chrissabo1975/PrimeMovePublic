class ArchitecturalComponents:
    TENSION_COMPUTATION = """
def compute_tension(scar_a, scar_b):
    domain_overlap = 1.0 if scar_a['domain'] == scar_b['domain'] else 0.3
    combined_tension = (scar_a['tension_index'] + scar_b['tension_index']) / 2.0
    gen_distance = abs(scar_a['generation'] - scar_b['generation'])
    recency_factor = 1.0 / (1.0 + gen_distance * 0.1)
    return domain_overlap * combined_tension * recency_factor
"""
    SCAR_WEIGHT_FORMULA = """
def compute_scar_weight(content, tension_index):
    import math
    precision = 1.0 / math.log(len(content) + 1)
    return tension_index * precision
"""
    GOAL_RELEVANCE_SCORING = """
def compute_goal_relevance(scar, goal):
    domain_score = 1.0 if scar['domain'] in goal['domain_cluster'] else 0.2
    tension_score = scar['tension_index']
    sw = set(scar['content'].lower().split()) - {'the','a','an','is','are','to','of','in','and','or','but'}
    gw = set(goal['statement'].lower().split()) - {'the','a','an','is','are','to','of','in','and','or','but'}
    content_score = len(sw & gw) / max(len(sw), len(gw)) if sw and gw else 0.0
    return (domain_score * 0.4) + (tension_score * 0.4) + (content_score * 0.2)
"""
    SYNTHESIS_PROMPT = """
def build_synthesis_prompt(filename, domain, chunk_scars):
    lines = [f"SYNTHESIS — Document: {filename} | Domain: {domain}", f"Chunk scars ({len(chunk_scars)}):"]
    for cs in chunk_scars:
        lines.append(f"  Scar {cs['id']} [t={cs['tension_index']:.2f}]: {cs['content']}")
    lines.append("\\nWhat is the single irreducible distinction this document makes?")
    return "\\n".join(lines)
"""
    REGISTRY = {
        "tension_computation": TENSION_COMPUTATION,
        "scar_weight_formula": SCAR_WEIGHT_FORMULA,
        "goal_relevance_scoring": GOAL_RELEVANCE_SCORING,
        "synthesis_prompt": SYNTHESIS_PROMPT,
    }
    IMMUTABLE = {
        "phi_validation_gate", "goal_alignment_check",
        "scar_append_only_log", "five_stage_cycle_structure",
        "interaction_pipeline", "reverse_cycle_pruning"
    }


class ArchitectureManager:
    def __init__(self, arch_path=ARCH_LOG_PATH):
        self.arch_path = arch_path
        self.components = copy.deepcopy(ArchitecturalComponents.REGISTRY)
        self.modification_history = []
        self.phi_stability_log = []
        self.stable_generation_count = 0
        self.architecture_unlocked = False
        self._live_functions = {}
        self._load_or_init()
        self._compile_components()

    def _load_or_init(self):
        if os.path.exists(self.arch_path):
            with open(self.arch_path, 'r') as f:
                data = json.load(f)
            self.components = data.get("components", copy.deepcopy(ArchitecturalComponents.REGISTRY))
            self.modification_history = data.get("modification_history", [])
            self.phi_stability_log = data.get("phi_stability_log", [])
            self.stable_generation_count = data.get("stable_generation_count", 0)
            self.architecture_unlocked = data.get("architecture_unlocked", False)
        else:
            self._save()

    def _save(self):
        with open(self.arch_path, 'w') as f:
            json.dump({
                "components": self.components,
                "modification_history": self.modification_history,
                "phi_stability_log": self.phi_stability_log,
                "stable_generation_count": self.stable_generation_count,
                "architecture_unlocked": self.architecture_unlocked
            }, f, indent=4)

    def _compile_components(self):
        for name, source in self.components.items():
            try:
                ns = {}
                exec(source, ns)
                for k, v in ns.items():
                    if callable(v) and not k.startswith('_'):
                        self._live_functions[name] = v
                        break
            except Exception as e:
                print(f"[ARCH] Warning: Could not compile {name}: {e}")

    def get_function(self, name: str) -> Optional[Callable]:
        return self._live_functions.get(name)

    def update_phi_stability(self, phi_distance: float, generation: int):
        self.phi_stability_log.append({"generation": generation, "phi_distance": phi_distance})
        if phi_distance < ARCH_PHI_THRESHOLD:
            self.stable_generation_count += 1
        else:
            self.stable_generation_count = 0
        if not self.architecture_unlocked and self.stable_generation_count >= ARCH_STABILITY_GENERATIONS:
            self.architecture_unlocked = True
            print(f"\n[ARCH] *** SELF-ARCHITECTURE UNLOCKED ***")
        self._save()

    def is_unlocked(self) -> bool:
        return self.architecture_unlocked

    def get_stability_status(self) -> str:
        if self.architecture_unlocked:
            return "UNLOCKED"
        rem = ARCH_STABILITY_GENERATIONS - self.stable_generation_count
        return f"LOCKED — {self.stable_generation_count}/{ARCH_STABILITY_GENERATIONS} ({rem} remaining)"

    def propose_modification(self, component_name: str, new_source: str) -> tuple:
        if not self.architecture_unlocked:
            return False, "Not yet unlocked"
        if component_name in ArchitecturalComponents.IMMUTABLE:
            return False, f"'{component_name}' is immutable"
        if component_name not in self.components:
            return False, f"Unknown component"
        try:
            tree = ast.parse(new_source)
        except SyntaxError as e:
            return False, f"Syntax error: {e}"
        if not [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]:
            return False, "Must define a function"
        return True, "Valid"

    def apply_modification(self, name: str, source: str, phi_delta: float,
                            rationale: str, generation: int, sandbox: dict):
        self.components[name] = source
        self.modification_history.append({
            "component": name, "generation": generation,
            "rationale": rationale, "phi_delta": phi_delta,
            "sandbox_results": sandbox, "verdict": "applied"
        })
        self._compile_components()
        self._save()

    def reject_modification(self, name: str, rationale: str, phi_delta: float,
                             generation: int, reason: str, sandbox: dict):
        self.modification_history.append({
            "component": name, "generation": generation,
            "rationale": rationale, "phi_delta": phi_delta,
            "sandbox_results": sandbox, "verdict": f"rejected — {reason}"
        })
        self._save()

    def show_status(self):
        print(f"\n{'═'*60}\nARCHITECTURE — {self.get_stability_status()}\n{'═'*60}")
        for name in self.components:
            mods = len([m for m in self.modification_history
                       if m["component"] == name and m["verdict"] == "applied"])
            print(f"  {name}: {mods} modifications")


class GoalManager:
    def __init__(self, goal_path=GOAL_LOG_PATH):
        self.goal_path = goal_path
        self.goals = []
        self._arch_manager = None
        self._load_or_init()

    def set_arch_manager(self, arch_manager):
        self._arch_manager = arch_manager

    def _load_or_init(self):
        if os.path.exists(self.goal_path):
            with open(self.goal_path, 'r') as f:
                data = json.load(f)
            self.goals = data.get("goals", [])
        else:
            self.goals = []
            self._save()

    def _save(self):
        with open(self.goal_path, 'w') as f:
            json.dump({"goals": self.goals}, f, indent=4)

    def add_goal(self, statement: str, source: str, domain_cluster: list,
                 priority_weight: float, parent_scar_ids: list = None) -> dict:
        g = {"id": len(self.goals)+1, "statement": statement, "source": source,
             "domain_cluster": domain_cluster, "priority_weight": priority_weight,
             "status": "active", "parent_scar_ids": parent_scar_ids or [],
             "cycles_active": 0, "resolution_progress": 0.0}
        self.goals.append(g)
        self._save()
        return g

    def get_active_goals(self) -> list:
        return sorted([g for g in self.goals if g["status"] == "active"],
                     key=lambda x: x["priority_weight"], reverse=True)

    def get_highest_priority_goal(self) -> Optional[dict]:
        a = self.get_active_goals()
        return a[0] if a else None

    def update_goal_progress(self, goal_id: int, delta: float):
        for g in self.goals:
            if g["id"] == goal_id:
                g["resolution_progress"] = min(1.0, g["resolution_progress"] + delta)
                g["cycles_active"] += 1
                if g["resolution_progress"] >= 1.0:
                    g["status"] = "resolved"
                    print(f"\n[GOAL] Goal {goal_id} RESOLVED")
                self._save()
                return

    def flag_for_review(self, goal_id: int):
        for g in self.goals:
            if g["id"] == goal_id:
                g["status"] = "review"
                self._save()
                return

    def compute_goal_relevance(self, scar: dict, goal: dict) -> float:
        if self._arch_manager:
            fn = self._arch_manager.get_function("goal_relevance_scoring")
            if fn:
                try:
                    return fn(scar, goal)
                except Exception:
                    pass
        ds = 1.0 if scar["domain"] in goal["domain_cluster"] else 0.2
        sw = set(scar["content"].lower().split()) - {'the','a','an','is','are','to','of','in','and','or'}
        gw = set(goal["statement"].lower().split()) - {'the','a','an','is','are','to','of','in','and','or'}
        cs = len(sw & gw) / max(len(sw), len(gw)) if sw and gw else 0.0
        return ds * 0.4 + scar["tension_index"] * 0.4 + cs * 0.2

    def show_goals(self):
        if not self.goals:
            print("\n[GOALS] No goals yet.")
            return
        print(f"\n{'═'*60}\nGOAL LOG — {len(self.goals)} total\n{'═'*60}")
        for g in self.goals:
            sym = {"active":"▶","resolved":"✓","suspended":"⏸","review":"⚠"}.get(g["status"],"?")
            print(f"\n{sym} Goal {g['id']} [{g['source']}] "
                  f"p={g['priority_weight']:.2f} prog={g['resolution_progress']:.0%}: "
                  f"{g['statement'][:80]}")


