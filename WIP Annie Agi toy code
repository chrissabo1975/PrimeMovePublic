class ScarMemory:
    def __init__(self, log_path=SCAR_LOG_PATH):
        self.log_path = log_path
        self.scars = []
        self.generation_index = 0
        self._arch_manager = None
        self._load_or_init()

    def set_arch_manager(self, arch_manager):
        self._arch_manager = arch_manager

    def _load_or_init(self):
        if os.path.exists(self.log_path):
            with open(self.log_path, 'r') as f:
                data = json.load(f)
            self.scars = data.get("scars", [])
            self.generation_index = data.get("generation_index", 0)
        else:
            self.scars = []
            self.generation_index = 0
            self._save()

    def _save(self):
        with open(self.log_path, 'w') as f:
            json.dump({
                "scars": self.scars,
                "generation_index": self.generation_index
            }, f, indent=4)

    def _compute_weight(self, content: str, tension_index: float) -> float:
        if self._arch_manager:
            fn = self._arch_manager.get_function("scar_weight_formula")
            if fn:
                try:
                    return fn(content, tension_index)
                except Exception:
                    pass
        return tension_index / math.log(len(content) + 1)

    def add_scar(self, content: str, domain: str, tension_index: float,
                 parent_ids: list = None, source: str = None) -> dict:
        scar_id = len(self.scars) + 1
        # Use max existing id + 1 to avoid collisions after pruning
        if self.scars:
            scar_id = max(s["id"] for s in self.scars) + 1
        weight = self._compute_weight(content, tension_index)
        new_scar = {
            "id": scar_id,
            "content": content,
            "domain": domain,
            "tension_index": tension_index,
            "generation": self.generation_index,
            "weight": weight,
            "parent_ids": parent_ids or [],
            "source": source or "user",
            "flagged_for_review": False
        }
        self.scars.append(new_scar)
        self._save()
        return new_scar

    def get_scar_by_id(self, scar_id: int) -> Optional[dict]:
        for s in self.scars:
            if s["id"] == scar_id:
                return s
        return None

    def get_phi_ratio(self, window: int = 5) -> float:
        weights = [s["weight"] for s in self.scars if s["weight"] > 0]
        if len(weights) < 2:
            return 1.0
        ratios = []
        for i in range(max(0, len(weights) - window), len(weights) - 1):
            if weights[i] > 0:
                ratios.append(weights[i + 1] / weights[i])
        return sum(ratios) / len(ratios) if ratios else 1.0

    def get_phi_ratio_for_scars(self, scar_subset: list) -> float:
        weights = [s["weight"] for s in scar_subset if s["weight"] > 0]
        if len(weights) < 2:
            return 1.0
        ratios = []
        for i in range(len(weights) - 1):
            if weights[i] > 0:
                ratios.append(weights[i + 1] / weights[i])
        return sum(ratios) / len(ratios) if ratios else 1.0

    def get_last_n_scars(self, n: int) -> list:
        return self.scars[-n:] if len(self.scars) >= n else self.scars[:]

    def get_unresolved_tension_summary(self, threshold: float = 0.6,
                                        max_scars: int = 10) -> str:
        high = [s for s in self.scars if s["tension_index"] >= threshold]
        if not high:
            return "No active tensions. Substrate stable."
        high.sort(key=lambda x: x["weight"], reverse=True)
        return "\n".join(
            f"[Gen {s['generation']}] [{s['domain']}] "
            f"tension={s['tension_index']:.2f} weight={s['weight']:.4f}: "
            f"{s['content']}"
            for s in high[-max_scars:]
        )

    def get_max_tension(self) -> float:
        return max((s["tension_index"] for s in self.scars), default=0.0)

    def get_flagged_scars(self) -> list:
        return [s for s in self.scars if s.get("flagged_for_review")]

    def get_scar_quality_summary(self) -> dict:
        if not self.scars:
            return {}
        lengths = [len(s["content"]) for s in self.scars]
        tensions = [s["tension_index"] for s in self.scars]
        weights = [s["weight"] for s in self.scars]
        low_weight = [s for s in self.scars
                     if s["weight"] < PRUNE_LOW_WEIGHT
                     and s["tension_index"] < PRUNE_LOW_TENSION]
        return {
            "total_scars": len(self.scars),
            "avg_scar_length": sum(lengths) / len(lengths),
            "avg_tension": sum(tensions) / len(tensions),
            "avg_weight": sum(weights) / len(weights),
            "phi_ratio": self.get_phi_ratio(),
            "phi_distance": abs(self.get_phi_ratio() - PHI),
            "high_tension_count": len([t for t in tensions if t >= 0.6]),
            "low_tension_count": len([t for t in tensions if t < 0.3]),
            "long_scar_count": len([l for l in lengths if l > 200]),
            "prune_candidate_count": len(low_weight),
            "flagged_count": len(self.get_flagged_scars())
        }


