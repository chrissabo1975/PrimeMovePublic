    def _load_or_init(self):
        if os.path.exists(self.config_path):
            with open(self.config_path, 'r') as f:
                data = json.load(f)
            self.current_config = data.get("current_config", DEFAULT_CONFIG)
            self.current_prompt = data.get("current_prompt", DEFAULT_SYSTEM_PROMPT)
            self.modification_history = data.get("modification_history", [])
        else:
            self._save()

    def _save(self):
        with open(self.config_path, 'w') as f:
            json.dump({"current_config": self.current_config,
                      "current_prompt": self.current_prompt,
                      "modification_history": self.modification_history}, f, indent=4)

    def get(self, key: str):
        return self.current_config.get(key, DEFAULT_CONFIG.get(key))

    def set_interaction_mode(self, mode: str):
        if mode in ("off","passive","active","full"):
            self.current_config["interaction_mode"] = mode
            self._save()
            print(f"[ANNIE] Mode: {mode}")
        else:
            print(f"[ANNIE] Invalid mode. Use: off/passive/active/full")

    def toggle_auto_prune(self):
        current = self.current_config.get("auto_prune", False)
        self.current_config["auto_prune"] = not current
        self._save()
        print(f"[ANNIE] Auto-prune: {'ON' if not current else 'OFF'}")

    def _bump(self, v: str, level: int) -> str:
        parts = v.split(".")
        while len(parts) < 3:
            parts.append("0")
        try:
            if level == 1:
                parts[1] = str(int(parts[1])+1); parts[2] = "0"
            else:
                parts[2] = str(int(parts[2])+1)
        except ValueError:
            pass
        return ".".join(parts)

    def apply_parameter_modification(self, params, phi_delta, rationale, generation):
        old = copy.deepcopy(self.current_config)
        self.current_config.update(params)
        self.current_config["version"] = self._bump(self.current_config["version"], 2)
        self.modification_history.append({"type":"parameter","generation":generation,
            "rationale":rationale,"phi_delta":phi_delta,
            "old":{k:old.get(k) for k in params},"new":params,"verdict":"applied"})
        self._save()

    def apply_prompt_modification(self, new_prompt, phi_delta, rationale, generation):
        self.current_prompt = new_prompt
        self.current_config["version"] = self._bump(self.current_config["version"], 1)
        self.modification_history.append({"type":"prompt","generation":generation,
            "rationale":rationale,"phi_delta":phi_delta,"verdict":"applied"})
        self._save()

    def reject_modification(self, mod_type, proposed, phi_delta, rationale,
                             generation, reason="phi degraded"):
        self.modification_history.append({"type":mod_type,"generation":generation,
            "rationale":rationale,"phi_delta":phi_delta,
            "proposed":str(proposed)[:200],"verdict":f"rejected — {reason}"})
        self._save()

    def show_history(self):
        print(f"\n{'═'*50}\nMODIFICATION HISTORY — v{self.current_config['version']}\n{'═'*50}")
        for m in self.modification_history:
            print(f"\n[Gen {m['generation']}] {m['type'].upper()} — {m['verdict']}")
            print(f"  {m['rationale'][:100]}")


