def compute_tension_between_scars(a, b, arch_manager=None):
    if arch_manager:
        fn = arch_manager.get_function("tension_computation")
        if fn:
            try: return fn(a, b)
            except: pass
    dom = 1.0 if a["domain"] == b["domain"] else 0.3
    comb = (a["tension_index"] + b["tension_index"]) / 2.0
    rec = 1.0 / (1.0 + abs(a["generation"] - b["generation"]) * 0.1)
    return dom * comb * rec

def find_highest_tension_pair(scars, threshold=0.6, arch_manager=None):
    if len(scars) < 2: return None
    best, best_t = None, 0.0
    cands = [s for s in scars if s["tension_index"] >= threshold]
    for i in range(len(cands)):
        for j in range(i+1, len(cands)):
            t = compute_tension_between_scars(cands[i], cands[j], arch_manager)
            if t > best_t:
                best_t = t
                best = (cands[i], cands[j], t)
    return best

def find_goal_aware_split(memory, config, goal_manager, arch_manager):
    ag = goal_manager.get_highest_priority_goal()
    threshold = config.get("tension_threshold")
    if ag is None:
        return find_highest_tension_pair(memory.scars, threshold, arch_manager)
    rt = config.get("goal_relevance_threshold")
    relevant = [(s, goal_manager.compute_goal_relevance(s, ag))
               for s in memory.scars
               if s["tension_index"] >= threshold
               and goal_manager.compute_goal_relevance(s, ag) >= rt]
    if len(relevant) < 2:
        return find_highest_tension_pair(memory.scars, threshold, arch_manager)
    best, best_s = None, 0.0
    for i in range(len(relevant)):
        for j in range(i+1, len(relevant)):
            a, ra = relevant[i]; b, rb = relevant[j]
            t = compute_tension_between_scars(a, b, arch_manager)
            score = t * ((ra+rb)/2.0)
            if score > best_s:
                best_s = score; best = (a, b, t)
    return best or find_highest_tension_pair(memory.scars, threshold, arch_manager)

def compute_goal_progress_delta(scar, goal, goal_manager):
    return goal_manager.compute_goal_relevance(scar, goal) * (1.0 - scar["tension_index"]) * 0.1

def goal_aware_validation_gate(proposed, memory, config, goal_manager):
    last = memory.get_last_n_scars(10)
    if len(last) < 3: return 'apply', 0.0, True, False
    cur_d = abs(memory.get_phi_ratio_for_scars(last) - PHI)
    sim = copy.deepcopy(last)
    if proposed["type"] == "parameter" and proposed.get("param_name"):
        p, v = proposed["param_name"], proposed.get("param_value")
        if p == "tension_threshold" and v is not None:
            for s in sim:
                if s["tension_index"] < v: s["tension_index"] = 0.0; s["weight"] = 0.0
        elif p == "temperature" and v is not None:
            d = config.get("temperature") - v
            for s in sim: s["weight"] = min(s["weight"]*(1.0+d*0.1), 1.0)
    elif proposed.get("prompt_addition"):
        for s in sim:
            if len(s["content"]) > 100:
                s["weight"] = s["tension_index"] / math.log(int(len(s["content"])*0.9)+1)
    sim_d = abs(memory.get_phi_ratio_for_scars(sim) - PHI)
    phi_delta = cur_d - sim_d
    phi_ok = phi_delta > 0
    ag = goal_manager.get_highest_priority_goal()
    goal_ok = True
    if ag:
        if proposed["type"] == "parameter":
            p, v = proposed.get("param_name",""), proposed.get("param_value",0)
            goal_ok = ((p=="tension_threshold" and v<=config.get("tension_threshold")) or
                      (p=="temperature" and v<=config.get("temperature")) or
                      p not in ("tension_threshold","temperature"))
        elif proposed.get("prompt_addition"):
            add = proposed.get("prompt_addition","").lower()
            gw = set(ag["statement"].lower().split())
            aw = set(add.split())
            stop = {'the','a','an','is','are','to','of','in','and','or'}
            goal_ok = bool((gw-stop)&(aw-stop)) or any(d in add for d in ag["domain_cluster"])
    if phi_ok and goal_ok: return 'apply', phi_delta, True, False
    elif phi_ok and not goal_ok: return 'review', phi_delta, False, True
    elif not phi_ok and goal_ok: return 'reject', phi_delta, True, False
    else: return 'reject_hard', phi_delta, False, False

def detect_emergent_goal(memory, config, goal_manager):
    if len(memory.scars) < 5: return None
    clusters = {}
    for s in memory.scars:
        clusters.setdefault(s["domain"],[]).append(s)
    best_d = max(clusters, key=lambda d: sum(s["tension_index"] for s in clusters[d])/len(clusters[d]))
    high = sorted([s for s in clusters[best_d] if s["tension_index"] >= config.get("tension_threshold")],
                 key=lambda x: x["weight"], reverse=True)[:5]
    if not high: return None
    avg_t = sum(s["tension_index"] for s in high)/len(high)
    summary = "\n".join(f"  Scar {s['id']} [t={s['tension_index']:.2f}]: {s['content']}" for s in high)
    prompt = f"These are highest-tension scars in domain '{best_d}':\n{summary}\nName the resolution state.\nGOAL_STATEMENT: [one sentence]\nPRIORITY: [0.0-1.0]"
    try:
        r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,"prompt":prompt,"stream":False,"options":{"temperature":0.1}})
        r.raise_for_status()
        raw = r.json().get("response","")
        gs = p = None
        for line in raw.split('\n'):
            if line.startswith("GOAL_STATEMENT:"): gs = line.split(":",1)[1].strip()
            elif line.startswith("PRIORITY:"):
                try: p = float(line.split(":",1)[1].strip())
                except: pass
        if not gs: return None
        p = max(0.0, min(1.0, p or avg_t))
        for eg in goal_manager.get_active_goals():
            if eg["domain_cluster"] == [best_d]:
                eg["priority_weight"] = max(eg["priority_weight"], p)
                goal_manager._save()
                return eg
        ng = goal_manager.add_goal(gs,"emergent",[best_d],p,[s["id"] for s in high])
        print(f"\n[GOAL] Emergent: Goal {ng['id']} — {gs}")
        return ng
    except: return None

def inject_goal(statement, memory, config, goal_manager, arch_manager):
    print(f"\n[GOAL] Injecting: {statement[:80]}...")
    dc = {}
    for s in memory.scars: dc[s["domain"]] = dc.get(s["domain"],0)+s["tension_index"]
    domains = [d for d,_ in sorted(dc.items(),key=lambda x:x[1],reverse=True)[:3]] or ["general"]
    prompt = f"{DEFAULT_SYSTEM_PROMPT}\n### GOAL FORMATION CYCLE\nGoal: {statement}\nDomains: {', '.join(domains)}\nRun the Prime Move cycle.\nPRIORITY: [0.0-1.0]\nDOMAIN_CLUSTER: [comma-separated]"
    try:
        r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,"prompt":prompt,"stream":False,"options":{"temperature":0.1}})
        r.raise_for_status()
        raw = r.json().get("response","")
        sc = statement
        sm = re.search(r"###\s*SCAR\s*\n(.*?)(?=TENSION_INDEX|###|\Z)",raw,re.DOTALL|re.IGNORECASE)
        if sm: sc = re.sub(r'\n+',' ',sm.group(1).strip()).strip()
        ti = 0.7
        tm = re.search(r"TENSION_INDEX:\s*([0-9]*\.?[0-9]+)",raw,re.IGNORECASE)
        if tm: ti = max(0.0,min(1.0,float(tm.group(1))))
        priority = ti
        pm = re.search(r"PRIORITY:\s*([0-9]*\.?[0-9]+)",raw,re.IGNORECASE)
        if pm: priority = max(0.0,min(1.0,float(pm.group(1))))
        dc_raw = domains
        dm = re.search(r"DOMAIN_CLUSTER:\s*(.+)",raw,re.IGNORECASE)
        if dm:
            parsed = [re.sub(r'[^a-zA-Z0-9_]','_',d.strip().lower()) for d in dm.group(1).split(',')]
            if parsed: dc_raw = parsed[:5]
        gs = memory.add_scar(sc,"goal_formation",ti,source="goal_injection")
        ng = goal_manager.add_goal(statement,"injected",dc_raw,priority,[gs["id"]])
        print(f"[GOAL] Goal {ng['id']} | priority={priority:.3f}")
        return ng
    except: return None


