def run_cycle(payload_text, memory, config, goal_manager, arch_manager,
              interaction_manager, pruning_engine,
              domain="general", parent_ids=None,
              source=None, skip_interaction=False):

    current_gen = memory.generation_index + 1

    if not skip_interaction and config.get("interaction_mode") != "off":
        payload_text, conflict_resolved, was_initiated = run_interaction_pipeline(
            payload_text, memory, config, goal_manager, arch_manager,
            interaction_manager, current_gen
        )

    unresolved = memory.get_unresolved_tension_summary(
        threshold=config.get("tension_threshold"),
        max_scars=config.get("max_tension_scars_in_context")
    )
    ag = goal_manager.get_highest_priority_goal()
    goal_ctx = f"\n### ACTIVE GOAL\nGoal {ag['id']}: {ag['statement']}\nProgress: {ag['resolution_progress']:.0%}\n" if ag else ""

    flagged = memory.get_flagged_scars()
    flag_ctx = ""
    if flagged and config.get("interaction_mode") != "off":
        flag_ctx = "\n### FLAGGED SCARS (user overrides):\n" + "\n".join(
            f"  Scar {s['id']}: {s['content']}" for s in flagged[:3]
        )

    # Show prune candidates if many
    q = memory.get_scar_quality_summary()
    prune_ctx = ""
    if q.get("prune_candidate_count",0) >= PRUNE_MIN_CLUSTER:
        prune_ctx = f"\n[NOTE: {q['prune_candidate_count']} scars are pruning candidates]"

    prompt = f"""{config.current_prompt}

### ACTIVE SCAR SUBSTRATE
{unresolved}
{goal_ctx}{flag_ctx}{prune_ctx}
### GENERATION {current_gen} | DOMAIN: {domain}

### PAYLOAD
{payload_text}

Execute the cycle. Produce the scar.
"""

    print(f"\n[ANNIE v4.5] Gen {current_gen} — {domain} "
          f"[mode={config.get('interaction_mode')}]")
    if ag: print(f"[ANNIE v4.5] Goal: {ag['statement'][:60]}...")
    print(f"[ANNIE v4.5] {payload_text[:80]}...")

    try:
        r = requests.post(LOCAL_LLM_URL, json={
            "model": MODEL_NAME, "prompt": prompt,
            "stream": False, "options": {"temperature": config.get("temperature")}
        })
        r.raise_for_status()
        output = r.json().get("response","")
        print("\n--- OUTPUT ---"); print(output); print("--------------")

        sc = "Distinction made but not precisely identified."
        sm = re.search(r"###\s*SCAR\s*\n(.*?)(?=TENSION_INDEX|###|\Z)",output,re.DOTALL|re.IGNORECASE)
        if sm: sc = re.sub(r'\n+',' ',sm.group(1).strip()).strip()

        ti = 0.5
        tm = re.search(r"TENSION_INDEX:\s*([0-9]*\.?[0-9]+)",output,re.IGNORECASE)
        if tm: ti = max(0.0,min(1.0,float(tm.group(1))))

        new_scar = memory.add_scar(sc,domain,ti,parent_ids=parent_ids or [],source=source or "user")
        memory.generation_index = current_gen
        memory._save()

        if ag:
            delta = compute_goal_progress_delta(new_scar, ag, goal_manager)
            goal_manager.update_goal_progress(ag["id"], delta)

        phi_ratio = memory.get_phi_ratio(config.get("phi_convergence_window"))
        phi_distance = abs(phi_ratio - PHI)
        arch_manager.update_phi_stability(phi_distance, current_gen)

        print(f"\n[PHI] w={new_scar['weight']:.4f} | ratio={phi_ratio:.4f} | dist={phi_distance:.4f}")
        if phi_distance < 0.05: print(f"[PHI] *** CONVERGING ON φ ***")

        if memory.generation_index % config.get("emergent_goal_interval") == 0 and memory.generation_index > 0:
            detect_emergent_goal(memory, config, goal_manager)

        # Auto-prune check
        if pruning_engine.check_auto_prune():
            pruning_engine.run_prune()

        return new_scar

    except requests.exceptions.ConnectionError:
        print("\n[ERROR] Cannot reach LLM. Run: ollama serve")
        return None


def run_autonomous_cycle(memory, config, goal_manager, arch_manager,
                          interaction_manager, pruning_engine):
    pair = find_goal_aware_split(memory, config, goal_manager, arch_manager)
    if pair is None:
        print("\n[ANNIE] Substrate stable."); return None
    sa, sb, t = pair
    ag = goal_manager.get_highest_priority_goal()
    payload = (f"AUTONOMOUS SPLIT — tension={t:.3f}\n"
              f"Scar {sa['id']}: {sa['content']}\n"
              f"Scar {sb['id']}: {sb['content']}\n"
              f"What distinction resolves this without erasing either scar?")
    if ag: payload += f"\n\nActive goal: {ag['statement']}"
    scar = run_cycle(payload, memory, config, goal_manager, arch_manager,
                    interaction_manager, pruning_engine,
                    domain="autonomous", parent_ids=[sa["id"],sb["id"]],
                    source="autonomous", skip_interaction=True)
    if scar:
        memory.generation_index += 1
        memory._save()
    return scar


class PerceptionLayer:
    def __init__(self, data_dir=DATA_DIR, processed_log=PROCESSED_LOG_PATH):
        self.data_dir = data_dir
        self.processed_log = processed_log
        self.manifest = load_manifest()
        if not os.path.exists(self.data_dir): os.makedirs(self.data_dir)

    def _get_processed(self):
        if not os.path.exists(self.processed_log): return set()
        with open(self.processed_log,'r') as f: return set(l.strip() for l in f)

    def _mark_processed(self, fn):
        with open(self.processed_log,'a') as f: f.write(fn+"\n")

    def get_unprocessed(self):
        processed = self._get_processed()
        return sorted([f for f in os.listdir(self.data_dir)
                      if f.endswith('.txt') and f not in processed])

    def process_file(self, filename, memory, config, goal_manager,
                     arch_manager, interaction_manager, pruning_engine):
        with open(os.path.join(self.data_dir,filename),'r',encoding='utf-8') as f:
            content = f.read()
        print(f"\n[PERCEPTION] {filename} ({len(content)} chars)")
        domain = infer_domain(content, filename, self.manifest)
        print(f"[PERCEPTION] Domain: {domain}")
        chunks = chunk_text(content, config.get("chunk_size"))
        print(f"[PERCEPTION] {len(chunks)} chunks")
        chunk_ids = []
        for i, chunk in enumerate(chunks):
            print(f"[PERCEPTION] Chunk {i+1}/{len(chunks)}")
            s = run_cycle(chunk, memory, config, goal_manager, arch_manager,
                         interaction_manager, pruning_engine,
                         domain=domain, source=f"file:{filename}:chunk{i+1}",
                         skip_interaction=True)
            if s:
                chunk_ids.append(s["id"])
                memory.generation_index += 1
                memory._save()
        if not chunk_ids: return None
        if len(chunk_ids) == 1: return memory.get_scar_by_id(chunk_ids[0])
        cs = [memory.get_scar_by_id(cid) for cid in chunk_ids if memory.get_scar_by_id(cid)]
        fn_arch = arch_manager.get_function("synthesis_prompt")
        sp = fn_arch(filename,domain,cs) if fn_arch else (
            f"SYNTHESIS — {filename}\n" +
            "\n".join(f"  Scar {c['id']}: {c['content']}" for c in cs) +
            "\nSingle irreducible distinction?"
        )
        result = run_cycle(sp, memory, config, goal_manager, arch_manager,
                          interaction_manager, pruning_engine,
                          domain=domain, parent_ids=chunk_ids,
                          source=f"file:{filename}:synthesis", skip_interaction=True)
        if result:
            self._mark_processed(filename)
            print(f"[PERCEPTION] Complete → Scar {result['id']}")
        return result

    def process_all(self, memory, config, goal_manager, arch_manager,
                    interaction_manager, pruning_engine):
        files = self.get_unprocessed()
        if not files: print("\n[PERCEPTION] No files."); return
        for i, fn in enumerate(files):
            print(f"\n[PERCEPTION] {i+1}/{len(files)}: {fn}")
            self.process_file(fn, memory, config, goal_manager,
                            arch_manager, interaction_manager, pruning_engine)
            if i < len(files)-1 and memory.get_max_tension() >= config.get("auto_cycle_threshold"):
                run_autonomous_cycle(memory, config, goal_manager,
                                    arch_manager, interaction_manager, pruning_engine)


