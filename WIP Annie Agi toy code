def build_lineage_tree(scar_id, memory, archive=None, depth=0, visited=None):
    if visited is None: visited = set()
    if scar_id in visited: return "  "*depth + f"[circular: {scar_id}]"
    visited.add(scar_id)
    s = memory.get_scar_by_id(scar_id)
    if s is None:
        # Check archive
        if archive:
            s = archive.get_archived_by_id(scar_id)
            if s:
                ind = "  "*depth
                return (f"{ind}[ARCHIVED] Scar {s['id']} [{s['domain']}]: "
                       f"{s['content'][:60]}...")
        return "  "*depth + f"[Scar {scar_id} not found]"
    ind = "  "*depth; con = "└─" if depth > 0 else "●"
    prev = s['content'][:80]+('...' if len(s['content'])>80 else '')
    src = f" [{s.get('source','')}]" if s.get('source','') in ('pruning_residual','pruning_meta') else ""
    lines = [
        f"{ind}{con} Scar {s['id']} [Gen {s['generation']}] [{s['domain']}]{src} "
        f"t={s['tension_index']:.2f} w={s['weight']:.4f}",
        f"{ind}   {prev}"
    ]
    for pid in s.get("parent_ids",[]):
        lines.append(build_lineage_tree(pid, memory, archive, depth+1, visited))
    return "\n".join(lines)

def show_lineage(memory, archive=None, top_n=5):
    if not memory.scars: print("\n[LINEAGE] No scars yet."); return
    top = sorted(memory.scars, key=lambda x: x["weight"], reverse=True)[:top_n]
    print(f"\n{'═'*60}\nLINEAGE TREE — Top {top_n}\n{'═'*60}")
    for s in top:
        print(f"\n{build_lineage_tree(s['id'], memory, archive)}")
        print(f"{'─'*40}")

def load_manifest():
