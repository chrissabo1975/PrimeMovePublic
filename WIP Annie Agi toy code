def infer_domain(content, filename=None, manifest=None):
    if manifest and filename and filename in manifest: return manifest[filename]
    try:
        r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,
            "prompt":f"Identify domain 1-3 words snake_case. ONLY label.\n\n{content[:500]}",
            "stream":False,"options":{"temperature":0.0,"num_predict":20}})
        r.raise_for_status()
        d = re.sub(r'[^a-zA-Z0-9_]','_',r.json().get("response","").strip().lower())[:30].strip('_')
        return d if d else "general"
    except:
        if filename: return re.sub(r'[^a-zA-Z0-9_]','_',os.path.splitext(filename)[0].lower())[:30]
        return "general"

def chunk_text(text, size):
    chunks = []; rem = text.strip()
    while len(rem) > size:
        sp = rem[:size].rfind('\n\n')
        if sp==-1: sp = rem[:size].rfind('. ')
        if sp==-1: sp = size
        chunks.append(rem[:sp].strip()); rem = rem[sp:].strip()
    if rem: chunks.append(rem)
    return chunks


