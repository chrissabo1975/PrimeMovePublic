# PRUNING ENGINE
# ══════════════════════════════════════════════════════════════

class PruningEngine:
    """
    Annie's reverse-cycle pruning system.

    Identifies clusters of low-weight, redundant scars and
    compresses them into single residual scars through the
    reverse Prime Move cycle.

    This is not deletion — it is structural compression through
    the same mechanism that produced the scars in the first place.
    """

    def __init__(self, memory: 'ScarMemory', config: 'ConfigManager',
                 archive_manager: ArchiveManager):
        self.memory = memory
        self.config = config
        self.archive = archive_manager

    def identify_clusters(self, domain: str = None) -> list:
        """
        Identify clusters of scars that are candidates for compression.

        Clustering criteria:
        1. Weight below PRUNE_LOW_WEIGHT threshold
        2. Tension below PRUNE_LOW_TENSION threshold
        3. Same domain (or specified domain)
        4. Not already flagged as residual scars

        Returns list of clusters (each cluster is a list of scars).
        """
        # Get candidate scars
        candidates = [
            s for s in self.memory.scars
            if (s["weight"] < PRUNE_LOW_WEIGHT and
                s["tension_index"] < PRUNE_LOW_TENSION and
                s.get("source") not in ("self_architecture_applied",
                                        "pruning_residual") and
                not s.get("flagged_for_review"))
        ]

        if domain:
            candidates = [s for s in candidates if s["domain"] == domain]

        if not candidates:
            return []

        # Group by domain
        domain_groups = {}
        for scar in candidates:
            d = scar["domain"]
            domain_groups.setdefault(d, []).append(scar)

        # Return clusters with minimum size
        clusters = []
        for d, scars in domain_groups.items():
            if len(scars) >= PRUNE_MIN_CLUSTER:
                # Sort by weight ascending (weakest first)
                scars.sort(key=lambda x: x["weight"])
                clusters.append(scars)

        return clusters

    def run_reverse_cycle(self, cluster: list) -> Optional[dict]:
        """
        Run the reverse Prime Move cycle on a cluster.

        Asks the LLM to extract the irreducible residual scar
        that the cluster was collectively trying to express.

        Returns the raw LLM output parsed into a structured result,
        or None if the reverse cycle fails quality checks.
        """
        cluster_avg_tension = sum(s["tension_index"] for s in cluster) / len(cluster)
        cluster_avg_length = sum(len(s["content"]) for s in cluster) / len(cluster)

        cluster_summary = "\n".join(
            f"  Scar {s['id']} [domain={s['domain']}] "
            f"[w={s['weight']:.4f}] [t={s['tension_index']:.2f}]: "
            f"{s['content']}"
            for s in cluster
        )

        prompt = f"""{REVERSE_CYCLE_PROMPT}

### CLUSTER TO COMPRESS
Domain: {cluster[0]['domain']}
Cluster size: {len(cluster)} scars
Average tension: {cluster_avg_tension:.3f}
Average content length: {cluster_avg_length:.0f} chars

Scars:
{cluster_summary}

Run the reverse cycle. Extract the residual scar.
The residual MUST be shorter than {int(cluster_avg_length * 0.8)} characters.
The residual TENSION_INDEX MUST be higher than {cluster_avg_tension:.3f}.
"""

        try:
            response = requests.post(LOCAL_LLM_URL, json={
                "model": MODEL_NAME,
                "prompt": prompt,
                "stream": False,
                "options": {"temperature": 0.1}
            })
            response.raise_for_status()
            raw = response.json().get("response", "")

            print(f"\n[PRUNE] Reverse cycle output:")
            print(raw[:500] + ("..." if len(raw) > 500 else ""))

            # Extract residual scar content
            residual_content = None
            scar_match = re.search(
                r"###\s*SCAR\s*\n(.*?)(?=TENSION_INDEX|###|\Z)",
                raw, re.DOTALL | re.IGNORECASE
            )
            if scar_match:
                residual_content = re.sub(
                    r'\n+', ' ', scar_match.group(1).strip()
                ).strip()

            # Extract tension index
            tension_index = cluster_avg_tension * 1.2  # Default: higher than average
            tension_match = re.search(
                r"TENSION_INDEX:\s*([0-9]*\.?[0-9]+)",
                raw, re.IGNORECASE
            )
            if tension_match:
                tension_index = max(0.0, min(1.0, float(tension_match.group(1))))

            # Extract compression rationale
            rationale = "Cluster compressed via reverse cycle."
            rat_match = re.search(
                r"###\s*COMPRESSION_RATIONALE\s*\n(.+)",
                raw, re.IGNORECASE
            )
            if rat_match:
                rationale = rat_match.group(1).strip()

            if not residual_content:
                print(f"[PRUNE] Could not extract residual scar from reverse cycle.")
                return None

            return {
                "content": residual_content,
                "tension_index": tension_index,
                "rationale": rationale,
                "raw_output": raw[:500]
            }

        except requests.exceptions.ConnectionError:
            print("\n[PRUNE] Cannot reach LLM for reverse cycle.")
            return None

    def validate_residual(self, residual: dict, cluster: list) -> tuple:
        """
        Quality gate for residual scars.

        A residual scar must:
        1. Be shorter than RESIDUAL_MAX_LENGTH characters
        2. Be shorter than the average cluster scar
        3. Have higher tension_index than cluster average
        4. Have higher weight than cluster average (when computed)
        5. Improve phi convergence when added to substrate

        Returns (passes: bool, reason: str)
        """
        cluster_avg_tension = sum(s["tension_index"] for s in cluster) / len(cluster)
        cluster_avg_length = sum(len(s["content"]) for s in cluster) / len(cluster)
        cluster_avg_weight = sum(s["weight"] for s in cluster) / len(cluster)

        content = residual["content"]
        tension = residual["tension_index"]

        # Check 1: Length
        if len(content) > RESIDUAL_MAX_LENGTH:
            return False, (f"Too long ({len(content)} chars, "
                          f"max {RESIDUAL_MAX_LENGTH})")

        # Check 2: Shorter than average
        if len(content) >= cluster_avg_length:
            return False, (f"Not shorter than cluster average "
                          f"({len(content)} >= {cluster_avg_length:.0f})")

        # Check 3: Higher tension
        if tension <= cluster_avg_tension:
            return False, (f"Tension not higher than cluster average "
                          f"({tension:.3f} <= {cluster_avg_tension:.3f})")

        # Check 4: Phi convergence
        # Simulate: remove cluster, add residual, check phi
        simulated_scars = [
            s for s in self.memory.scars
            if s["id"] not in {c["id"] for c in cluster}
        ]

        # Compute simulated residual weight
        precision = 1.0 / math.log(len(content) + 1)
        residual_weight = tension * precision

        if residual_weight <= cluster_avg_weight:
            return False, (f"Weight not higher than cluster average "
                          f"({residual_weight:.4f} <= {cluster_avg_weight:.4f})")

        # Check phi convergence
        current_phi = self.memory.get_phi_ratio()
        current_phi_d = abs(current_phi - PHI)

        # Simulate phi with residual replacing cluster
        sim_weights = [s["weight"] for s in simulated_scars if s["weight"] > 0]
        sim_weights.append(residual_weight)

        if len(sim_weights) >= 2:
            ratios = []
            window = min(5, len(sim_weights) - 1)
            for i in range(max(0, len(sim_weights) - window), len(sim_weights) - 1):
                if sim_weights[i] > 0:
                    ratios.append(sim_weights[i + 1] / sim_weights[i])
            sim_phi = sum(ratios) / len(ratios) if ratios else 1.0
            sim_phi_d = abs(sim_phi - PHI)

            if sim_phi_d >= current_phi_d:
                return False, (f"Phi does not improve "
                              f"({sim_phi_d:.4f} >= {current_phi_d:.4f})")

        return True, "Passes all quality gates"

    def compress_cluster(self, cluster: list) -> Optional[dict]:
        """
        Run the full compression pipeline on a cluster.

        1. Run reverse cycle → extract residual
        2. Validate residual quality
        3. If passes: add residual to memory, archive cluster, log meta-scar
        4. If fails: log failed attempt as scar, return None
        """
        domain = cluster[0]["domain"]
        generation = self.memory.generation_index

        print(f"\n[PRUNE] Compressing cluster of {len(cluster)} scars "
              f"in domain '{domain}'")
        for s in cluster:
            print(f"  Scar {s['id']} [w={s['weight']:.4f}]: {s['content'][:60]}")

        # Run reverse cycle
        residual_result = self.run_reverse_cycle(cluster)
        if not residual_result:
            return None

        # Validate
        passes, reason = self.validate_residual(residual_result, cluster)

        if not passes:
            print(f"\n[PRUNE] ✗ Quality gate failed: {reason}")
            # Log failed attempt as a scar — system learns what doesn't compress well
            self.memory.add_scar(
                content=(f"Failed compression attempt for {len(cluster)} scars "
                        f"in '{domain}': {reason}"),
                domain="pruning_meta",
                tension_index=0.4,
                source="pruning_failed"
            )
            return None

        print(f"\n[PRUNE] ✓ Quality gate passed: {reason}")
        print(f"[PRUNE] Residual: {residual_result['content']}")
        print(f"[PRUNE] Tension: {residual_result['tension_index']:.3f}")

        # Add residual scar to active memory with cluster as parents
        residual_scar = self.memory.add_scar(
            content=residual_result["content"],
            domain=domain,
            tension_index=residual_result["tension_index"],
            parent_ids=[s["id"] for s in cluster],
            source="pruning_residual"
        )

        # Remove cluster from active memory
        cluster_ids = {s["id"] for s in cluster}
        self.memory.scars = [
            s for s in self.memory.scars
            if s["id"] not in cluster_ids
        ]
        self.memory._save()

        # Archive the cluster
        event = self.archive.archive_cluster(
            cluster, residual_scar, generation, domain
        )

        # Log pruning event as meta-scar
        self.memory.add_scar(
            content=(f"Compressed {len(cluster)} scars in '{domain}' into "
                    f"Scar {residual_scar['id']}: "
                    f"{residual_result['rationale'][:80]}"),
            domain="pruning_meta",
            tension_index=0.3,
            parent_ids=[residual_scar["id"]],
            source="pruning_meta"
        )

        phi_after = self.memory.get_phi_ratio()
        print(f"\n[PRUNE] Compression complete:")
        print(f"[PRUNE] {len(cluster)} scars → 1 residual (Scar {residual_scar['id']})")
        print(f"[PRUNE] φ ratio after: {phi_after:.4f}")

        return residual_scar

    def run_prune(self, domain: str = None) -> int:
        """
        Run the pruning pipeline across all eligible clusters
        (or a specific domain).

        Returns the number of clusters compressed.
        """
        print(f"\n[PRUNE] Scanning for compressible clusters...")

        clusters = self.identify_clusters(domain)

        if not clusters:
            print(f"[PRUNE] No eligible clusters found.")
            if domain:
                print(f"[PRUNE] Domain '{domain}' has no low-weight cluster "
                      f"of {PRUNE_MIN_CLUSTER}+ scars.")
            else:
                print(f"[PRUNE] All scars above weight/tension thresholds "
                      f"or clusters too small.")
            return 0

        print(f"[PRUNE] Found {len(clusters)} eligible cluster(s):")
        for i, c in enumerate(clusters):
            print(f"  Cluster {i+1}: {len(c)} scars in '{c[0]['domain']}'")

        compressed = 0
        for cluster in clusters:
            result = self.compress_cluster(cluster)
            if result:
                compressed += 1

        print(f"\n[PRUNE] Complete: {compressed}/{len(clusters)} clusters compressed.")
        return compressed

    def check_auto_prune(self) -> bool:
        """
        Check if auto-prune should trigger based on scar count
        and generation interval.
        """
        if not self.config.get("auto_prune"):
            return False

        scar_count = len(self.memory.scars)
        generation = self.memory.generation_index

        if scar_count >= PRUNE_AUTO_THRESHOLD:
            print(f"\n[PRUNE] Auto-prune triggered: "
                  f"{scar_count} scars >= {PRUNE_AUTO_THRESHOLD}")
            return True

        if generation > 0 and generation % PRUNE_AUTO_INTERVAL == 0:
            print(f"\n[PRUNE] Auto-prune triggered: "
                  f"generation {generation} interval reached")
            return True

        return False

    def show_prune_status(self):
        """Show current pruning eligibility status."""
        candidates = [
            s for s in self.memory.scars
            if (s["weight"] < PRUNE_LOW_WEIGHT and
                s["tension_index"] < PRUNE_LOW_TENSION)
        ]
        clusters = self.identify_clusters()

        print(f"\n{'═' * 60}")
        print(f"PRUNING STATUS")
        print(f"{'═' * 60}")
        print(f"Total scars: {len(self.memory.scars)}")
        print(f"Auto-prune: {'ON' if self.config.get('auto_prune') else 'OFF'}")
        print(f"Auto-prune threshold: {PRUNE_AUTO_THRESHOLD} scars")
        print(f"\nCandidate scars (w<{PRUNE_LOW_WEIGHT}, t<{PRUNE_LOW_TENSION}): "
              f"{len(candidates)}")
        print(f"Eligible clusters (size>={PRUNE_MIN_CLUSTER}): {len(clusters)}")
        if clusters:
            print(f"\nClusters ready for compression:")
            for i, c in enumerate(clusters):
                avg_w = sum(s["weight"] for s in c) / len(c)
                avg_t = sum(s["tension_index"] for s in c) / len(c)
                print(f"  Cluster {i+1}: {len(c)} scars in '{c[0]['domain']}' "
                      f"avg_w={avg_w:.4f} avg_t={avg_t:.3f}")
        print(f"\nArchived scars: {len(self.archive.archived_scars)}")
        print(f"Pruning events: {len(self.archive.pruning_events)}")


