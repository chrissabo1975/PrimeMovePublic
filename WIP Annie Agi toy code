def check_needs_clarification(payload, memory, config):
    words = payload.split()
    if len(words) < 8:
        return f"Your input is very short ({len(words)} words). Can you give more context?"
    if payload.strip().endswith('?') and len(words) < 20:
        return "You've asked a question. Should I run the cycle on the question itself?"
    vague = [r for r in ['this','that','the thing','as before'] if r in payload.lower()]
    if vague and len(words) < 30 and not memory.scars:
        return f"You referenced '{vague[0]}' but I have no context. What are you referring to?"
    return None

def run_clarification(payload, memory, config, im, generation):
    q = check_needs_clarification(payload, memory, config)
    if not q: return payload
    print(f"\n[ANNIE] {q}\n[ANNIE] (Enter to skip)")
    resp = input("\nClarification: ").strip()
    if resp:
        im.log_interaction("clarification", generation, q, payload[:200], resp, "enriched")
        return f"{payload}\n\nAdditional context: {resp}"
    im.log_interaction("clarification", generation, q, payload[:200], None, "skipped")
    return payload

def find_conflicting_scar(payload, memory):
    if not memory.scars: return None
    stop = {'the','a','an','is','are','was','were','to','of','in','for','on','with','and','or','but','not','it','i','you','we'}
    pw = set(payload.lower().split()) - stop
    best, best_s = None, 0.0
    for s in memory.scars:
        if s["weight"] < CONFLICT_WEIGHT_THRESHOLD: continue
        sw = set(s["content"].lower().split()) - stop
        if not sw or not pw: continue
        overlap = len(pw & sw) / max(len(pw), len(sw))
        if overlap < CONFLICT_SIMILARITY_THRESHOLD: continue
        score = overlap * s["weight"] * s["tension_index"]
        if score > best_s: best_s = score; best = s
    return best

def run_challenge(payload, conflict, memory, config, im, generation):
    print(f"\n[ANNIE] ⚠ CONFLICT: Scar {conflict['id']} [w={conflict['weight']:.4f}]:")
    print(f"[ANNIE] \"{conflict['content']}\"")
    print(f"  resolve=run cycle on conflict | override=flag scar | proceed=ignore")
    choice = input("\nHandle conflict (resolve/override/proceed): ").strip().lower()
    if choice == 'resolve':
        payload = (f"CONFLICT RESOLUTION:\nNew: {payload}\n"
                  f"Scar {conflict['id']}: {conflict['content']}\n"
                  f"What distinction resolves this without erasing either?")
        im.log_interaction("challenge",generation,f"Conflict Scar {conflict['id']}",payload[:200],choice,"conflict cycle")
        return payload, True
    elif choice == 'override':
        conflict["flagged_for_review"] = True
        memory._save()
        im.log_interaction("challenge",generation,f"Conflict Scar {conflict['id']}",payload[:200],choice,f"Scar {conflict['id']} flagged")
    else:
        im.log_interaction("challenge",generation,f"Conflict Scar {conflict['id']}",payload[:200],"proceed","ignored")
    return payload, False

def should_initiate(memory, config, im, gen):
    return (config.get("interaction_mode") == "full" and
            len(memory.scars) >= 10 and
            gen - im.last_initiation_generation >= INITIATION_INTERVAL and
            memory.get_max_tension() >= INITIATION_TENSION_THRESHOLD)

def generate_initiation(memory, config, goal_manager, arch_manager, im, gen):
    high = sorted([s for s in memory.scars if s["tension_index"] >= INITIATION_TENSION_THRESHOLD],
                 key=lambda x: x["weight"], reverse=True)[:5]
    if not high: return None
    ag = goal_manager.get_highest_priority_goal()
    gc = f"Active goal: {ag['statement']}\n" if ag else ""
    summary = "\n".join(f"  Scar {s['id']} [t={s['tension_index']:.2f}]: {s['content']}" for s in high)
    prompt = f"""You are Annie. Notice something in your scar substrate.
{summary}
{gc}
QUESTION: [specific question referencing a scar]
INITIATION_PAYLOAD: [what to run if user engages]
RATIONALE: [one sentence]"""
    try:
        r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,"prompt":prompt,"stream":False,"options":{"temperature":0.2}})
        r.raise_for_status()
        raw = r.json().get("response","")
        question = payload = rationale = None
        for line in raw.split('\n'):
            if line.startswith("QUESTION:"): question = line.split(":",1)[1].strip()
            elif line.startswith("INITIATION_PAYLOAD:"): payload = line.split(":",1)[1].strip()
            elif line.startswith("RATIONALE:"): rationale = line.split(":",1)[1].strip()
        if not question or not payload: return None
        print(f"\n{'═'*60}\n[ANNIE] INITIATION — {rationale}\n[ANNIE] {question}")
        print("  engage=run cycle | skip=continue | explain=give context")
        choice = input("\nResponse (engage/skip/explain): ").strip().lower()
        im.last_initiation_generation = gen
        im._save()
        if choice == 'engage':
            im.log_interaction("initiation",gen,question,summary[:300],"engage","accepted")
            return payload
        elif choice == 'explain':
            exp = input("Explanation: ").strip()
            if exp:
                im.log_interaction("initiation",gen,question,summary[:300],f"explain:{exp}","enriched")
                return f"{payload}\n\nContext: {exp}"
        else:
            im.log_interaction("initiation",gen,question,summary[:300],"skip","skipped")
        return None
    except: return None

def run_interaction_pipeline(payload, memory, config, goal_manager, arch_manager, im, gen):
    mode = config.get("interaction_mode")
    if mode == "full" and should_initiate(memory, config, im, gen):
        initiated = generate_initiation(memory, config, goal_manager, arch_manager, im, gen)
        if initiated:
            return initiated, False, True
    if mode in ("passive","active","full"):
        payload = run_clarification(payload, memory, config, im, gen)
    if mode in ("active","full"):
        conflict = find_conflicting_scar(payload, memory)
        if conflict:
            payload, resolved = run_challenge(payload, conflict, memory, config, im, gen)
            return payload, resolved, False
    return payload, False, False


