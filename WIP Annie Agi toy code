class SelfModificationEngine:
    def __init__(self, memory, config, goal_manager, arch_manager):
        self.memory = memory; self.config = config
        self.goal_manager = goal_manager; self.arch_manager = arch_manager

    def run_self_modification_cycle(self):
        print(f"\n[SELF-MOD] Running...")
        q = self.memory.get_scar_quality_summary()
        if not q: print("[SELF-MOD] Need 5+ scars."); return None
        ag = self.goal_manager.get_highest_priority_goal()
        gc = f"\nActive goal: {ag['statement']}" if ag else ""
        prompt = f"Propose ONE improvement.\nMetrics: {json.dumps(q,indent=2)}\n{gc}\nTarget phi_distance→0. Current:{q.get('phi_distance','?')}\nFormat:\nMODIFICATION_TYPE: [parameter OR prompt]\nRATIONALE: [one sentence]\nPARAMETER_NAME: [if parameter]\nPARAMETER_VALUE: [if parameter]\nPROMPT_ADDITION: [if prompt]"
        try:
            r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,"prompt":prompt,"stream":False,"options":{"temperature":0.1}})
            r.raise_for_status()
            raw = r.json().get("response","")
        except: return None
        d = {}
        for line in raw.split('\n'):
            for key in ("MODIFICATION_TYPE","RATIONALE","PARAMETER_NAME","PARAMETER_VALUE","PROMPT_ADDITION"):
                if line.strip().startswith(f"{key}:"): d[key] = line.split(":",1)[1].strip()
        if not d.get("MODIFICATION_TYPE") or not d.get("RATIONALE"): return None
        proposed = {"type":d["MODIFICATION_TYPE"].lower(),"rationale":d["RATIONALE"],
                   "param_name":d.get("PARAMETER_NAME"),"prompt_addition":d.get("PROMPT_ADDITION")}
        try: proposed["param_value"] = float(d["PARAMETER_VALUE"])
        except: proposed["param_value"] = None
        verdict, phi_delta, goal_ok, review = goal_aware_validation_gate(proposed, self.memory, self.config, self.goal_manager)
        gen = self.memory.generation_index
        print(f"[SELF-MOD] {verdict} | φ:{phi_delta:+.4f}")
        if verdict == 'apply': return self._apply(proposed, phi_delta, gen)
        elif verdict == 'review':
            ag2 = self.goal_manager.get_highest_priority_goal()
            if ag2: self.goal_manager.flag_for_review(ag2["id"])
            if input("[REVIEW] Apply? (approve/skip): ").strip().lower() == 'approve':
                return self._apply(proposed, phi_delta, gen)
        reason = "phi degraded and goal misaligned" if verdict=='reject_hard' else "phi degraded"
        self.config.reject_modification(proposed["type"],proposed,phi_delta,proposed["rationale"],gen,reason)
        return self.memory.add_scar(f"Rejected: {proposed['rationale']}","self_modification",0.6,source="self_modification_rejected")

    def _apply(self, proposed, phi_delta, gen):
        if proposed["type"]=="parameter" and proposed.get("param_name") and proposed.get("param_value") is not None:
            p, v = proposed["param_name"], proposed["param_value"]
            if p in DEFAULT_CONFIG:
                self.config.apply_parameter_modification({p:v},phi_delta,proposed["rationale"],gen)
                return self.memory.add_scar(f"Self-modified {p} to {v}","self_modification",0.3,source="self_modification")
        elif proposed["type"]=="prompt" and proposed.get("prompt_addition"):
            self.config.apply_prompt_modification(self.config.current_prompt+f"\n{proposed['prompt_addition']}",phi_delta,proposed["rationale"],gen)
            return self.memory.add_scar(f"Self-modified prompt","self_modification",0.3,source="self_modification")
        return None


class SelfArchitectureEngine:
    def __init__(self, memory, config, arch_manager, goal_manager):
        self.memory = memory; self.config = config
        self.arch_manager = arch_manager; self.goal_manager = goal_manager

    def run_self_architecture_cycle(self):
        print(f"\n[ARCH] Running...")
        if not self.arch_manager.is_unlocked():
            print(f"[ARCH] {self.arch_manager.get_stability_status()}"); return None
        q = self.memory.get_scar_quality_summary()
        if not q: return None
        target = ("scar_weight_formula" if q.get("avg_scar_length",0)>150
                 else "tension_computation" if q.get("avg_tension",0)<0.4
                 else "tension_computation")
        print(f"[ARCH] Target: {target}")
        current = self.arch_manager.components.get(target,"")
        prompt = f"Propose improved Python for {target}.\nCurrent:\n{current}\nReturn ONLY 'def ...' function."
        try:
            r = requests.post(LOCAL_LLM_URL, json={"model":MODEL_NAME,"prompt":prompt,"stream":False,"options":{"temperature":0.2}})
            r.raise_for_status()
            raw = re.sub(r'```python\n?','',r.json().get("response","").strip())
            raw = re.sub(r'```\n?','',raw).strip()
            if not raw.startswith('def '): return None
        except: return None
        valid, reason = self.arch_manager.propose_modification(target, raw)
        if not valid:
            return self.memory.add_scar(f"Arch proposal rejected: {reason}","self_architecture",0.4,source="self_architecture_invalid")
        phi_d = abs(self.memory.get_phi_ratio()-PHI)
        sim_phi_d = phi_d * 0.95
        phi_delta = phi_d - sim_phi_d
        gen = self.memory.generation_index
        if phi_delta > 0:
            self.arch_manager.apply_modification(target,raw,phi_delta,f"Targeting {target}",gen,{"phi_delta":phi_delta,"passed":True})
            return self.memory.add_scar(f"Architectural modification to {target}","self_architecture",0.2,source="self_architecture_applied")
        else:
            self.arch_manager.reject_modification(target,f"Targeting {target}",phi_delta,gen,"phi degraded",{"phi_delta":phi_delta,"passed":False})
            return self.memory.add_scar(f"Rejected arch modification to {target}","self_architecture",0.6,source="self_architecture_rejected")


