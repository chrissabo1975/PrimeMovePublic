# ARCHIVE MANAGER
# ══════════════════════════════════════════════════════════════

class ArchiveManager:
    """
    Manages archived scars — scars that have been compressed
    into residual scars but are preserved permanently.

    Archive is append-only like the scar log.
    Archived scars are never deleted.
    They can be retrieved, viewed, and referenced by lineage.
    """

    def __init__(self, archive_path=ARCHIVE_LOG_PATH):
        self.archive_path = archive_path
        self.archived_scars = []
        self.pruning_events = []
        self._load_or_init()

    def _load_or_init(self):
        if os.path.exists(self.archive_path):
            with open(self.archive_path, 'r') as f:
                data = json.load(f)
            self.archived_scars = data.get("archived_scars", [])
            self.pruning_events = data.get("pruning_events", [])
        else:
            self.archived_scars = []
            self.pruning_events = []
            self._save()

    def _save(self):
        with open(self.archive_path, 'w') as f:
            json.dump({
                "archived_scars": self.archived_scars,
                "pruning_events": self.pruning_events
            }, f, indent=4)

    def archive_cluster(self, cluster: list, residual_scar: dict,
                        generation: int, domain: str) -> dict:
        """
        Archive a cluster of scars after compression.
        Returns the pruning event record.
        """
        # Add archived scars
        for scar in cluster:
            archived = copy.deepcopy(scar)
            archived["archived_at_generation"] = generation
            archived["compressed_into"] = residual_scar["id"]
            self.archived_scars.append(archived)

        # Log pruning event as meta-record
        event = {
            "id": len(self.pruning_events) + 1,
            "generation": generation,
            "domain": domain,
            "cluster_size": len(cluster),
            "cluster_ids": [s["id"] for s in cluster],
            "residual_scar_id": residual_scar["id"],
            "avg_cluster_weight": sum(s["weight"] for s in cluster) / len(cluster),
            "residual_weight": residual_scar["weight"],
            "compression_ratio": len(cluster) / 1,
        }
        self.pruning_events.append(event)
        self._save()
        return event

    def get_archived_by_id(self, scar_id: int) -> Optional[dict]:
        for s in self.archived_scars:
            if s["id"] == scar_id:
                return s
        return None

    def show_archive(self, last_n: int = 20):
        print(f"\n{'═' * 60}")
        print(f"ARCHIVE — {len(self.archived_scars)} scars, "
              f"{len(self.pruning_events)} pruning events")
        print(f"{'═' * 60}")
        if self.pruning_events:
            print(f"\nPruning events (most recent {min(5, len(self.pruning_events))}):")
            for e in self.pruning_events[-5:]:
                print(f"  Event {e['id']} [Gen {e['generation']}] "
                      f"domain={e['domain']} "
                      f"compressed {e['cluster_size']} scars → "
                      f"Scar {e['residual_scar_id']} "
                      f"(w: {e['avg_cluster_weight']:.4f} → "
                      f"{e['residual_weight']:.4f})")
        if self.archived_scars:
            print(f"\nRecent archived scars:")
            for s in self.archived_scars[-last_n:]:
                print(f"  [Archived Gen {s['archived_at_generation']}] "
                      f"Scar {s['id']} → Residual {s['compressed_into']}: "
                      f"{s['content'][:60]}")


